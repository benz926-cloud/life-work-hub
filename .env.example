# ================================================================
# Life Work Hub — 环境变量说明
# ================================================================
# 复制此文件为 .env.local，填入真实值。
# .env.local 不会提交到 Git（.gitignore 已覆盖 .env* 但例外允许 .env.example）。
# ================================================================

# ---- Supabase（必填）-------------------------------------------------
# 注册 Supabase 后，在项目 Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- LLM（可选）------------------------------------------------------
# 不配置则全站走本地确定性引擎，页面功能完整可用。
# 配置后启用 LLM 语义增强（意图消歧、内容摘要、穿搭理由等）。
#
# AI_PROVIDER=anthropic          # anthropic | openai | deepseek
# AI_API_KEY=sk-...
# AI_MODEL=claude-sonnet-5       # 默认根据 provider 自动选择
# AI_BASE_URL=                   # 可选：自建网关 / 兼容 OpenAI 协议的代理

# ---- 本地脚本用（仅本地，绝不要提交或进 CI）------------------------------
# seed-supabase.ts 需要 service_role key 来写入。
# 在 Supabase → Settings → API → service_role 获取。
#
# SUPABASE_SERVICE_KEY=eyJh...
# SEED_EMAIL=your@email.com

# ---- RLS 验证脚本用（只在本地 shell 或 .env.local，别提交、别进 CI）----
# anon key 就是上面的 NEXT_PUBLIC_SUPABASE_ANON_KEY，脚本会自动回退读取
# SUPABASE_ANON_KEY=
# service_role key 不受 RLS 限制，泄露等于整库裸奔
# SUPABASE_SERVICE_KEY=
# TEST_EMAIL_A=
# TEST_PASSWORD_A=
# TEST_EMAIL_B=
# TEST_PASSWORD_B=
